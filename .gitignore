# Gitignore for local-ai-siem-analyzer

# Python
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.egg-info/
dist/
build/
venv/
.venv/

# AI module config (chứa API key)
ai_module/config.yaml
ai_module/telegram.local.env
ai_module/gmail.local.env

# RAG vector store (sinh lại được)
ai_module/rag_data/*.db
ai_module/rag_data/chroma/
/rag_data/chroma/

# Ollama models (quá to cho git)
*.gguf

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
.claude/
*.bak

# Local one-shot data generator; canonical RAG data is tracked directly
ai_module/create_rag_data.py
# Superseded experimental lock output; use the tracked root pylock.toml.
ai_module/requirements.lock.toml

# Local dashboard runtime data
ai_module/dashboard_data/
ai_module/dashboard-run*.log

# Docker volumes (trên SIEM, không trong repo)
wazuh-data/
