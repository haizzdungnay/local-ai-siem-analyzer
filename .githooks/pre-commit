#!/usr/bin/env sh
set -eu

changed=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$changed" ] || exit 0

other=$(printf '%s\n' "$changed" | grep -Ev '^(CHANGELOG\.md|HANDOFF\.md)$' || true)
[ -n "$other" ] || exit 0

missing=""
printf '%s\n' "$changed" | grep -qx 'CHANGELOG.md' || missing="CHANGELOG.md"
printf '%s\n' "$changed" | grep -qx 'HANDOFF.md' || missing="${missing:+$missing, }HANDOFF.md"

if [ -n "$missing" ]; then
  printf 'Commit bị chặn: staged diff thiếu %s. Cập nhật và stage ledger trước.\n' "$missing" >&2
  exit 1
fi
